# =============================================================================
# KorUzMarket — Frontend environment variables
# Copy this file to .env.local and fill in values.
# Never commit .env.local to version control.
# =============================================================================

# ─── API Connection ───────────────────────────────────────────────────────────
# When running the backend locally via docker compose:
#   NEXT_PUBLIC_API_URL=/api/v1  (proxied by next.config.js → localhost:8000)
#
# When deploying to production:
#   NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
#
NEXT_PUBLIC_API_URL=/api/v1

# Set to "true" to call the real FastAPI backend.
# Leave "false" (or omit) to use the built-in mock data for UI development.
NEXT_PUBLIC_USE_REAL_API=false

# ─── Backend proxy (used by next.config.js rewrites in development) ───────────
# Only needed when NEXT_PUBLIC_API_URL starts with /api/v1 (proxy mode).
# In production this is irrelevant — set NEXT_PUBLIC_API_URL to the full URL.
BACKEND_URL=http://localhost:8000

# ─── Object Storage (MinIO) ───────────────────────────────────────────────────
# Public URL the browser uses to load product images served from MinIO.
# In dev with docker compose this is http://localhost:9000
# In production use your CDN/public endpoint, e.g. https://objects.yourdomain.com
NEXT_PUBLIC_MINIO_URL=http://localhost:9000
NEXT_PUBLIC_MINIO_BUCKET=product-images

# ─── App Info ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=KorUzMarket
NEXT_PUBLIC_APP_URL=http://localhost:3000
